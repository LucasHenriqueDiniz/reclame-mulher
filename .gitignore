# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Env
.env*
!.env.example

# uploads (complaint attachments)
/uploads

# IDE
.vscode/

# Claude Code's local permission file. NEVER commit it: allow-rules accumulate by
# clicking, and a rule that allowlists a command with a token in it puts that token
# in the repo.
**/.claude/settings.local.json

# derived kanban board — regenerate with /hexagram:board, never track it
.kanban.json

# Claude Code agent worktrees. These were tracked as five gitlinks with no
# .gitmodules, which made `git submodule status` abort for everyone. They are
# per-machine scratch checkouts, so they belong outside the index.
.claude/worktrees/

# Playwright. .auth holds real session cookies minted against the local E2E
# database — throwaway, but still session tokens, so they stay out of the index.
/e2e/.auth/
/e2e/.results/
/e2e/.report/
/test-results/
/playwright-report/
