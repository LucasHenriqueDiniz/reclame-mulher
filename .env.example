# Neon PostgreSQL — Pooled (for app/serverless). From Neon Console → Connect → "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Neon Direct (for drizzle-kit push/migrate). From Neon Console → Connect → "Direct connection"
# If unset, drizzle.config.ts falls back to DATABASE_URL
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# JWT session signing (e.g. openssl rand -base64 32)
SESSION_SECRET=your-secret-at-least-32-chars

# Optional: app URL for links in emails etc.
NEXT_PUBLIC_APP_URL=http://localhost:5000

# UploadThing (for blog image storage)
UPLOADTHING_TOKEN=your-uploadthing-token
